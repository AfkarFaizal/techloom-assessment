# Copy this file to .env and fill in your MongoDB Atlas connection string.
# Get it from Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <username>/<password> with your database user's credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Optional: database name (defaults to pos_inventory if not set)
MONGODB_DB_NAME=pos_inventory

# Optional: port the server listens on (defaults to 4001)
PORT=4001
